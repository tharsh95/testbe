{
  "name": "integration-test-api",
  "version": "1.0.0",
  "description": "A small, production-style Node.js backend with layered architecture using Express, SQLite, Zod",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "jest",
    "lint": "eslint src --ext .js",
    "format": "prettier --write src",
    "migrate": "node src/db/migrate.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "sqlite3": "^5.1.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.3.2",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node"
  }
}